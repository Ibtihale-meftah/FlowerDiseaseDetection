<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/camera_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <!-- CAMERA -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- TOP GRADIENT -->
    <View
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/top_gradient" />

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_menu"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NatureScan IA"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:gravity="center" />

        <ImageView
            android:id="@+id/settingsButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_settings"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- QR INFO DISPLAY -->
    <TextView
        android:id="@+id/tvQrInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="105dp"
        android:background="@drawable/bg_detected"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="Plante : --"
        android:textColor="#16A34A"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- FREEZE TEXT -->
    <TextView
        android:id="@+id/txtFreeze"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="145dp"
        android:background="@drawable/bg_freeze"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="DÉTECTION PAUSÉE"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- FLOATING ACTIONS : bien organisés -->
    <LinearLayout
        android:id="@+id/floatingActionsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- FREEZE / AUTO SAVE -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnFreeze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_pause"
            android:contentDescription="Figer et sauvegarder"
            app:tint="@android:color/white"
            app:backgroundTint="#5B4DFF"
            app:fabSize="normal" />

        <!-- QR SCAN -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnScanQr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Scanner QR Code"
            app:tint="@android:color/white"
            app:backgroundTint="#16A34A"
            app:fabSize="normal" />

        <!-- VOICE COMMAND -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnVoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Commande vocale"
            app:tint="@android:color/white"
            app:backgroundTint="#EF4444"
            app:fabSize="normal" />

    </LinearLayout>

    <!-- RESULT CARD -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="110dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/mainLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyse en cours..."
                android:textColor="#111111"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mainScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#5B4DFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/confidenceProgress"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="12dp"
                android:progress="0"
                app:indicatorColor="#5B4DFF"
                app:trackColor="#EAEAEA" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/inference_time_val"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Inférence : -- ms"
                    android:textColor="#666666"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvScanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_detected"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="Scan actif"
                    android:textColor="#16A34A"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCapture"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sauvegarder"
                    android:textAllCaps="true"
                    app:cornerRadius="18dp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Historique"
                    android:textAllCaps="true"
                    app:cornerRadius="18dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>